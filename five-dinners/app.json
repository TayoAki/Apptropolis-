{
  "expo": {
    "name": "Five Dinners",
    "slug": "five-dinners",
    "scheme": "fivedinners",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.appbuilder.fivedinners5hpa",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appbuilder.fivedinners5hpa"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f7bd3d63-ccb1-4404-9577-0322faafcba0"
      }
    },
    "owner": "tayom"
  }
}
