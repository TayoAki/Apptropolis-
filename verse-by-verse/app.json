{
  "expo": {
    "name": "Verse by Verse",
    "slug": "verse-by-verse",
    "scheme": "versebyverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.appbuilder.versebyverseqsz4",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appbuilder.versebyverseqsz4"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fb6e5447-a9c3-44e0-ba37-6a01b94e783f"
      }
    },
    "owner": "tayom"
  }
}
